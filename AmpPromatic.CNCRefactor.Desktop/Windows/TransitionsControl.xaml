<UserControl x:Class="AmpPromatic.CNCRefactor.Desktop.Windows.TransitionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AmpPromatic.CNCRefactor.Desktop.Windows"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Grid.Column="0" Grid.Row="0">
            <Label x:Name="TransitionsLabel" Content="Transitions for: select machine"/>
            <ListView x:Name="TransitionsListView" MaxHeight="170" Height="170"
          ScrollViewer.CanContentScroll="False">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Text to Replace" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBox Width="138" Height="20" Text="{Binding OldText}" Visibility="{Binding IsEditingVis}"/>
                                        <TextBlock Text="{Binding OldText}" Visibility="{Binding IsViewOnlyVis}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="New Text" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBox Width="138" Height="20" Text="{Binding NewText}" Visibility="{Binding IsEditingVis}"/>
                                        <TextBlock Text="{Binding NewText}" Visibility="{Binding IsViewOnlyVis}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="100">
                            <GridViewColumn.Header>
                                <Button x:Name="CreateNewTransitionButton" Content="Create New" Click="CreateNewTransitionButton_Click"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SaveTransitionButton" Content="Save" Click="SaveTransitionButton_Click" Visibility="{Binding IsEditingVis}"/>
                                        <Button x:Name="CancelTransitionButton" Content="Cancel" Click="CancelTransitionButton_Click" Visibility="{Binding IsEditingVis}"/>
                                        <Button x:Name="EditTransitionButton" Content="Edit" Click="EditTransitionButton_Click" Visibility="{Binding IsViewOnlyVis}"/>
                                        <Button x:Name="DeleteTransitionButton" Content="Delete" Click="DeleteTransitionButton_Click" Visibility="{Binding IsViewOnlyVis}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </Grid>
</UserControl>
