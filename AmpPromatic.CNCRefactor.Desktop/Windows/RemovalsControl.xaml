<UserControl x:Class="AmpPromatic.CNCRefactor.Desktop.Windows.RemovalsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AmpPromatic.CNCRefactor.Desktop.Windows"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Grid.Column="0" Grid.Row="0">
            <Label x:Name="RemovalsLabel" Content="Removals for: select machine"/>
            <ListView x:Name="RemovalsListView" MaxHeight="170" Height="170"
  ScrollViewer.CanContentScroll="False">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Text to Remove" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBox Width="138" Height="20" Text="{Binding Text}" Visibility="{Binding IsEditingVis}"/>
                                        <TextBlock Text="{Binding Text}" Visibility="{Binding IsViewOnlyVis}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="100">
                            <GridViewColumn.Header>
                                <Button x:Name="CreateNewRemovalButton" Content="Create New" Click="CreateNewRemovalButton_Click"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SaveRemovalButton" Content="Save" Click="SaveRemovalButton_Click" Visibility="{Binding IsEditingVis}"/>
                                        <Button x:Name="CancelRemovalButton" Content="Cancel" Click="CancelRemovalButton_Click" Visibility="{Binding IsEditingVis}"/>
                                        <Button x:Name="EditRemovalButton" Content="Edit" Click="EditRemovalButton_Click" Visibility="{Binding IsViewOnlyVis}"/>
                                        <Button x:Name="DeleteRemovalButton" Content="Delete" Click="DeleteRemovalButton_Click" Visibility="{Binding IsViewOnlyVis}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </Grid>
</UserControl>
