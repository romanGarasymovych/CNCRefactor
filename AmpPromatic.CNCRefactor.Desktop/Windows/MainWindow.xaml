<Window x:Class="AmpPromatic.CNCRefactor.Desktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AmpPromatic.CNCRefactor.Desktop" 
        xmlns:viewmodels="clr-namespace:AmpPromatic.CNCRefactor.Desktop.Windows" d:DataContext="{d:DesignInstance Type=viewmodels:MainWindow}"
        mc:Ignorable="d"
        Title="CNC Refactor" Height="450" Width="930" ResizeMode="NoResize">
    <Grid>
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_File">
                    <MenuItem Header="_Settings" Click="MachineSettingsMenuItem_Click"/>
                    <MenuItem Header="_About" Click="AboutMenuItem_Click"/>
                    <MenuItem Header="_Close" Click="CloseMenuItem_Click"/>
                </MenuItem>
            </Menu>
            <StackPanel Height="362">
                <Grid Margin="10,5,10,7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Text="Target Machine: " />
                        <ComboBox Name="ToMachineSelect" ItemsSource="{Binding Machines}"  DisplayMemberPath="Name" SelectedValuePath="MachineId" SelectedItem="{Binding ToMachine}" SelectedValue="{Binding ToMachine.MachineId}">
                        </ComboBox>
                    </StackPanel>
                </Grid>
                <Separator></Separator>
                <StackPanel Margin="10,5,10,7">
                    <Button Content="Select files" Click="BrowseButton_Click" Width="80" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Transition Files: " />
                        <TextBlock Width="300" VerticalAlignment="Center" Text="{Binding TransitionFilesString}" Visibility="{Binding IsViewOnlyVis}" />
                        <TextBox Width="300" x:Name="TransitionFilesTextBox" VerticalAlignment="Center" Visibility="{Binding IsEditingVis}" />
                        <Button VerticalAlignment="Center" Content="Edit" Visibility="{Binding IsViewOnlyVis}" Click="Button_Click" />
                        <Button VerticalAlignment="Center" Content="Ok" Visibility="{Binding IsEditingVis}" Click="Button_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ScrollViewer Height="220">
                            <ListView x:Name="TransitionFilesListView" ItemsSource="{Binding SelectedTransitionFiles}" MaxHeight="220" Height="220" ScrollViewer.CanContentScroll="False">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Transition Files" Width="320">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FilePath}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="100">
                                            <GridViewColumn.Header>
                                                <ComboBox x:Name="TransitionFilesHeaderComboBox" ItemsSource="{Binding Transitions}"  DisplayMemberPath="NewText" SelectedValuePath="TransitionId" SelectedItem="{Binding Transition}" SelectedValue="{Binding Transition.TransitionId}">
                                                </ComboBox>
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding Transitions}"  DisplayMemberPath="NewText" SelectedValuePath="TransitionId" SelectedItem="{Binding Transition.TransitionId}" SelectedValue="{Binding TransitionId, Mode=TwoWay}">
                                                    </ComboBox>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </ScrollViewer>
                        <ScrollViewer Height="220">
                            <ListView x:Name="FilesListView" ItemsSource="{Binding SelectedFiles}" MaxHeight="220" Height="220" ScrollViewer.CanContentScroll="False">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Non transition Files" Width="320">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FilePath}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="100">
                                            <GridViewColumn.Header>
                                                <ComboBox ItemsSource="{Binding Transitions}" DisplayMemberPath="NewText" SelectedValuePath="TransitionId" SelectedItem="{Binding NonTransition, Mode=TwoWay}" SelectedValue="{Binding NonTransition.TransitionId}">
                                                </ComboBox>
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding Transitions}"  DisplayMemberPath="NewText" SelectedValuePath="TransitionId" SelectedItem="{Binding Transition.TransitionId}" SelectedValue="{Binding TransitionId, Mode=TwoWay}">
                                                    </ComboBox>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </ScrollViewer>
                    </StackPanel>
                    
                </StackPanel>

                <CheckBox Margin="10,0,10,0" Name="OvewriteFile" IsChecked="False">Overwrite file(s)</CheckBox>
                <Button VerticalAlignment="Bottom" Content="Refactor" Click="RefactorButtonClick" Width="100"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
