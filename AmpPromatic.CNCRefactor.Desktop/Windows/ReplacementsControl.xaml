<UserControl x:Class="AmpPromatic.CNCRefactor.Desktop.Windows.ReplacementsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AmpPromatic.CNCRefactor.Desktop.Windows"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Grid.Column="0" Grid.Row="0">
            <Label x:Name="ReplacementsLabel" Content="Replacements for: select machine"/>
            <ListView x:Name="ReplacementsListView" MaxHeight="170" Height="170"
          ScrollViewer.CanContentScroll="False">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Text to Replace" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBox Width="138" Height="20" Text="{Binding TextToReplace}" Visibility="{Binding IsEditingVis}"/>
                                        <TextBlock Text="{Binding TextToReplace}" Visibility="{Binding IsViewOnlyVis}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="New Text" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBox Width="138" Height="20" Text="{Binding Text}" Visibility="{Binding IsEditingVis}"/>
                                        <TextBlock Text="{Binding Text}" Visibility="{Binding IsViewOnlyVis}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="100">
                            <GridViewColumn.Header>
                                <Button x:Name="CreateNewReplacementButton" Content="Create New" Click="CreateNewReplacementButton_Click"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SaveReplacementButton" Content="Save" Click="SaveReplacementButton_Click" Visibility="{Binding IsEditingVis}"/>
                                        <Button x:Name="CancelReplacementButton" Content="Cancel" Click="CancelReplacementButton_Click" Visibility="{Binding IsEditingVis}"/>
                                        <Button x:Name="EditReplacementButton" Content="Edit" Click="EditReplacementButton_Click" Visibility="{Binding IsViewOnlyVis}"/>
                                        <Button x:Name="DeleteReplacementButton" Content="Delete" Click="DeleteReplacementButton_Click" Visibility="{Binding IsViewOnlyVis}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </Grid>
</UserControl>
