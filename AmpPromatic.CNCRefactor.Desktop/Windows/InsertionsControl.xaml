<UserControl x:Class="AmpPromatic.CNCRefactor.Desktop.Windows.InsertionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AmpPromatic.CNCRefactor.Desktop.Windows"
             xmlns:viewmodels="clr-namespace:AmpPromatic.CNCRefactor.Desktop.Windows" d:DataContext="{d:DesignInstance Type=viewmodels:InsertionsControl}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Grid.Column="0" Grid.Row="0">
            <Label x:Name="InsertionsLabel" Content="Insertions: select machine, first"/>
            <ListView x:Name="InsertionsListView" MaxHeight="170" Height="170" ItemsSource="{Binding Insertions}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Text to Insert" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBox Width="138" Height="20" Text="{Binding Text}" Visibility="{Binding IsEditingVis}"/>
                                        <TextBlock Text="{Binding Text}" Visibility="{Binding IsViewOnlyVis}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Qualifier" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBox Width="138" Height="20" Text="{Binding Qualifier}" Visibility="{Binding IsEditingVis}"/>
                                        <TextBlock Text="{Binding Qualifier}" Visibility="{Binding IsViewOnlyVis}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Insertion Type" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <ComboBox IsEnabled="{Binding IsEditing}" ItemsSource="{Binding InsertionTypes}" DisplayMemberPath="Name" SelectedValuePath="Type" SelectedValue="{Binding InsertionType}">
                                        </ComboBox>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Width="100">
                            <GridViewColumn.Header>
                                <Button x:Name="CreateNewInsertionButton" Content="Create New" Click="CreateNewInsertionButton_Click"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="SaveInsertionButton" Content="Save" Click="SaveInsertionButton_Click" Visibility="{Binding IsEditingVis}"/>
                                        <Button x:Name="CancelInsertionButton" Content="Cancel" Click="CancelInsertionButton_Click" Visibility="{Binding IsEditingVis}"/>
                                        <Button x:Name="EditInsertionButton" Content="Edit" Click="EditInsertionButton_Click" Visibility="{Binding IsViewOnlyVis}"/>
                                        <Button x:Name="DeleteInsertionButton" Content="Delete" Click="DeleteInsertionButton_Click" Visibility="{Binding IsViewOnlyVis}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>

    </Grid>
</UserControl>
