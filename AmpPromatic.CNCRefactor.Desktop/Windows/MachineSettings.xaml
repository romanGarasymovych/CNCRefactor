<Window x:Class="AmpPromatic.CNCRefactor.Desktop.Windows.MachineSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AmpPromatic.CNCRefactor.Desktop.Windows"
        mc:Ignorable="d"
        Title="Settings" Height="500" Width="600">
    <Grid>
        <!--Machine Select or create-->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Column="0" Grid.Row="0">
                <Grid>
                    <Label Content="Machines"/>
                    <Button Content="Restore Defaults" HorizontalAlignment="Right" Margin="0,5,5,0" Click="RestoreDefaultsButton_Click" Name="RestoreDefaultsButton"/>
                </Grid>
                <ListView x:Name="MachinesListView" MaxHeight="180" Height="180" ItemsSource="{Binding Machines}">
                    <ListView.Style>
                        <Style TargetType="ListView">
                            <Style.Triggers>
                                <Trigger Property="HasItems"
                         Value="False">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListView">
                                                <TextBlock Text="No items..."/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.Style>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Name" Width="100">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBox Width="88" Height="20" Text="{Binding Name}" Visibility="{Binding IsEditingVis}"/>
                                            <TextBlock Text="{Binding Name}" Visibility="{Binding IsViewOnlyVis}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Extension" Width="80">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBox Width="68" Height="20" Text="{Binding Extension}" Visibility="{Binding IsEditingVis}"/>
                                            <TextBlock Text="{Binding Extension}" Visibility="{Binding IsViewOnlyVis}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="100">
                                <GridViewColumn.Header>
                                    <Button x:Name="CreateNewButton" Content="Create New" Click="CreateNewButton_Click"/>
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="SaveButton" Content="Save" Click="SaveButton_Click" Visibility="{Binding IsEditingVis}"/>
                                            <Button x:Name="CancelButton" Content="Cancel" Click="CancelMachineEditButton_Click" Visibility="{Binding IsEditingVis}"/>
                                            <Button x:Name="EditButton" Content="Edit" Click="EditButton_Click" Visibility="{Binding IsViewOnlyVis}"/>
                                            <Button x:Name="DeleteButton" Content="Delete" Click="DeleteButton_Click" Visibility="{Binding IsViewOnlyVis}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <Separator></Separator>
            </StackPanel>
            <TabControl Grid.Column="0" Grid.Row="1">
                <TabItem Header="Replacements">
                    <local:ReplacementsControl x:Name="ReplacementsControl"/>
                </TabItem>
                <TabItem Header="Insertions">
                    <local:InsertionsControl x:Name="InsertionsControl"/>
                </TabItem>
                <TabItem Header="Removals">
                    <local:RemovalsControl x:Name="RemovalsControl"/>
                </TabItem>
                <TabItem Header="Transitions">
                    <local:TransitionsControl x:Name="TransitionsControl"/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
